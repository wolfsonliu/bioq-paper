# LaTeX build artifacts (regenerated by latex/build.sh)
/latex/build/
/latex/references-escaped.bib
/latex/auto/
/latex/*.aux
/latex/*.bbl
/latex/*.blg
/latex/*.log
/latex/*.out
/latex/*.toc
/latex/*.fls
/latex/*.fdb_latexmk
/latex/*.synctex.gz

texmf-local

# LaTeX render outputs (compiled PDFs derive from the .tex sources).
# NOTE: scoped to latex/ so the committed figures/*.pdf stay tracked.
/latex/*.pdf
/latex/*.ps

# Python bytecode caches
__pycache__/
*.py[cod]

# Editor backup files
*~

# macOS
.DS_Store
